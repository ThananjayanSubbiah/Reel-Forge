# Copy this file to .env in the ReelForge-Studio project root.
# Enter credentials ONLY in your local .env file, never in chat or source code.
PEXELS_API_KEY=
# Optional fallback; not required for the initial Pexels integration.
PIXABAY_API_KEY=

# Executable names work when FFmpeg is on PATH. Otherwise use full paths.
# Example: FFMPEG_PATH=C:/Tools/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional absolute directories. Defaults are backend/data and backend/data/models.
# DATA_DIR=C:/path/to/ReelForge-Studio/backend/data
# MODEL_DIR=C:/path/to/ReelForge-Studio/backend/data/models

# AI Director (optional; Classic stock generation remains available without it).
# Install Ollama and pull this model manually. No model downloads occur on startup.
DIRECTOR_PROVIDER=ollama
DIRECTOR_URL=http://127.0.0.1:11434
DIRECTOR_MODEL=qwen3:4b
DIRECTOR_TIMEOUT=300
DIRECTOR_CONTEXT=8192
OLLAMA_PATH=
# Optional absolute model storage directory, e.g. D:/ReelForgeTools/models
# OLLAMA_MODELS_DIR=D:/ReelForgeTools/models
DIRECTOR_API_KEY=
# For an optional OpenAI-compatible service use DIRECTOR_PROVIDER=compatible,
# DIRECTOR_URL ending in /v1, and the provider's model/key. Costs depend on provider.
VISUAL_RELEVANCE_THRESHOLD=0.78

# Optional local ComfyUI; export a trusted workflow using its API format.
COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW=C:/path/to/workflow-api.json
# Exact string placeholders in workflow inputs are replaced:
# $PROMPT, $NEGATIVE, $WIDTH (512), $HEIGHT (896), $SEED.
# Optional launcher paths (installed separately, never downloaded on launch).
COMFYUI_PYTHON=
# COMFYUI_DIRECTORY=D:/ReelForgeTools/ComfyUI
# COMFYUI_WORKFLOW=D:/Projects/ReelForge-Studio/backend/workflows/sd15.json
# Optional background track: supply music you own or are licensed to publish.
# MUSIC_PATH=D:/Media/licensed-background.wav
